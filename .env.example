# Home Assistant connection
HA_URL=http://your-homeassistant-ip:8123
HA_TOKEN=your_long_lived_access_token

# Path to automations.yaml (Samba share for MCP server)
HA_AUTOMATIONS_PATH=Z:\automations.yaml

